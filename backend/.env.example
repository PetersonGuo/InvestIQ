STOCKASSIST_DATA_MODE=demo
# Set mode to massive and supply a key to use historical daily market data.
MASSIVE_API_KEY=
# STOCKASSIST_DB=/absolute/path/to/stockassist.sqlite3

# Real IBKR historical data: set STOCKASSIST_DATA_MODE=ibkr above.
# Requires logged-in TWS/IB Gateway with socket API enabled.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=71
# Typical ports: TWS paper 7497, TWS live 7496, Gateway paper 4002, live 4001.
# Read-Only API can stay enabled; StockAssist never sends broker orders.
